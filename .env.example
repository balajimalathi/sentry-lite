# Shared secret for UI login + Authorization: Bearer on /api/internal/*
# Used by Compose and by local `go run` / TUI (config loads this file).
ADMIN_TOKEN=change-me-long-random

# Host port bound to 127.0.0.1 (container still listens on 8080)
HTTP_PORT=8080

# Public URL used in alert links (defaults to http://localhost:8080)
# PUBLIC_URL=http://localhost:8080

# Ingest rate limit per project (requests/sec). 0 = unlimited.
# Local `go run` defaults to 0. Docker Compose defaults to 100 if unset.
# INGEST_RPS=0

# Purge raw event JSON older than N days. 0 = keep forever. Default 14.
# EVENT_RETENTION_DAYS=14

# Email alerts (host:port). Optional SMTP auth.
# ALERT_SMTP=localhost:1025
# ALERT_FROM=sentry-lite@localhost
# ALERT_SMTP_USER=
# ALERT_SMTP_PASS=

# Refuse to start if ADMIN_TOKEN is empty. Auto-enabled when running in Docker.
# REQUIRE_ADMIN_TOKEN=true
